# .streamlit/secrets.toml 예시 (실제 파일은 GitHub에 올리지 않는다)
[auth]
redirect_uri = "https://macmini.taila10ae5.ts.net/oauth2callback"
cookie_secret = "여기에_긴_임의_문자열"      # python -c "import secrets; print(secrets.token_hex(32))"
expose_tokens = ["access"]                 # 드라이브 저장에 필요

[auth.google]
client_id = "여기에_클라이언트_ID"
client_secret = "여기에_클라이언트_보안_비밀번호"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { "scope" = "openid profile email https://www.googleapis.com/auth/drive.file", "prompt" = "select_account consent" }
